 "doctype": "Print Format",
 "font_size": 14,
 "html": "{#- Costing versi ke customer: cuma harga jual + syarat penawaran.\n\n    Sama kayak Costing (Import): kertas melintang, tanpa kop surat, dan blok keterangan di atas\n    dipakai sebagai header halaman PDF supaya nomor halamannya beneran keisi dan bloknya keulang\n    di tiap halaman. Nomor halamannya nempel di blok itu (Page(s)), jadi footer nomor halaman\n    yang dipakai print format lain sengaja gak diikutin di sini. -#}\n\n{%- set vic_hide_letterhead = True -%}\n{%- set rfq = get_request_for_quotations(doc) | join(\", \") -%}\n\n<style>\n\t/* Frappe cuma baca aturan yang nempel persis di .print-format, terus dilempar ke\n\t   wkhtmltopdf sebagai opsi - ini yang bikin kertasnya melintang. */\n\t.print-format { orientation: landscape; }\n\n\t/* Blok keterangan dicabut Frappe dari badan dokumen buat dijadiin header halaman, dan waktu\n\t   dicabut pembungkus .vic-pf ikut ketinggalan. Makanya aturan di bawah sengaja gak dikaitin\n\t   ke .vic-pf - kalau dikaitin, di PDF gayanya ilang. */\n\t.cs-head { width: 100%; font-family: Arial, Helvetica, sans-serif; font-size: 11px; }\n\t.cs-head table { width: 100%; border-collapse: collapse; }\n\t.cs-head td { padding: 1px 0 !important; border: 0; vertical-align: top; }\n\t.cs-head .lbl { width: 60px; white-space: nowrap; }\n\t.cs-head .sep { width: 10px; }\n\t.cs-head .side { vertical-align: top; }\n\t.cs-head .side.right { width: 40%; padding-left: 20px !important; }\n\n\t/* baris total di kaki tabel: cuma angkanya, lurus di kolom Total Selling Price */\n\t.vic-pf .items tr.sum td { border-top: 1px solid #000; font-weight: 700; }\n\t.vic-pf .tnc { margin-top: 22px; font-size: 11px; }\n\t.vic-pf .tnc .lbl { width: 130px; }\n\t/* tabel syarat dikasih lebar tetap: kalau dibiarin auto, isinya kepotong ke baris baru\n\t   padahal kertasnya melintang dan ruangnya masih lega */\n\t.vic-pf .tnc .terms { width: 55%; margin-top: 4px; }\n</style>\n\n<div class=\"vic-pf\">\n\t{%- include \"vic_addon/templates/print_formats/vic_letterhead.html\" -%}\n\n\t<div id=\"header-html\">\n\t\t<table class=\"cs-head\">\n\t\t\t<tr>\n\t\t\t\t<td class=\"side\">\n\t\t\t\t\t<table>\n\t\t\t\t\t\t<tr><td class=\"lbl\">Our Ref</td><td class=\"sep\">:</td><td>{{ doc.name }}</td></tr>\n\t\t\t\t\t\t<tr><td class=\"lbl\">Our RFQ</td><td class=\"sep\">:</td><td>{{ rfq }}</td></tr>\n\t\t\t\t\t</table>\n\t\t\t\t</td>\n\t\t\t\t<td class=\"side right\">\n\t\t\t\t\t<table>\n\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t<td class=\"lbl\">Page(s)</td>\n\t\t\t\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t\t\t\t<td><span class=\"page\">1</span> of <span class=\"topage\">1</span></td>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t<td class=\"lbl\">Date</td>\n\t\t\t\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t\t\t\t<td>{{ frappe.utils.formatdate(doc.posting_date, \"MMMM d, yyyy\") }}</td>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t</table>\n\t\t\t\t</td>\n\t\t\t</tr>\n\t\t</table>\n\t</div>\n\n\t<table class=\"items\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th style=\"width: 6%\">No</th>\n\t\t\t\t<th style=\"width: 44%; text-align: left\">Description</th>\n\t\t\t\t<th style=\"width: 14%\">Qty</th>\n\t\t\t\t<th style=\"width: 18%; text-align: right\">Selling Price<div>{{ doc.currency }}</div></th>\n\t\t\t\t<th style=\"width: 18%; text-align: right\">Total Selling Price<div>{{ doc.currency }}</div></th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{%- set ns = namespace(no = 0) %}\n\t\t\t{%- for header, rows in group_items_by_header(doc.items) %}\n\t\t\t\t{%- set indent = \"indent\" if header else \"\" %}\n\t\t\t\t{%- if header %}\n\t\t\t\t\t<tr class=\"group\"><td colspan=\"5\">{{ header }}</td></tr>\n\t\t\t\t{%- endif %}\n\t\t\t\t{%- for item in rows %}\n\t\t\t\t\t{%- set ns.no = ns.no + 1 %}\n\t\t\t\t\t{%- set size = frappe.db.get_value(\"Item\", item.item_code, \"custom_size\") %}\n\t\t\t\t\t{%- set qty = item.qty | float %}\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"num\">{{ ns.no }}</td>\n\t\t\t\t\t\t<td class=\"{{ indent }}\">\n\t\t\t\t\t\t\t<div class=\"desc\">{{ item.item_name }}</div>\n\t\t\t\t\t\t\t{%- if size %}<div>Size : {{ size }}</div>{% endif %}\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td class=\"qty\">{{ qty | int if qty == qty | round(0) else \"%.2f\" | format(qty) }} {{ item.uom }}</td>\n\t\t\t\t\t\t<td class=\"money\">{{ frappe.utils.fmt_money(item.quotation_rate) }}</td>\n\t\t\t\t\t\t<td class=\"money\">{{ frappe.utils.fmt_money(item.quotation_amount) }}</td>\n\t\t\t\t\t</tr>\n\t\t\t\t{%- endfor %}\n\t\t\t{%- endfor %}\n\n\t\t\t{#- Catatan dicetak sebagai baris terakhir tabel, nempel di kolom Description -#}\n\t\t\t{%- set note_lines = (doc.note or \"\").splitlines() | map(\"trim\") | select | list %}\n\t\t\t{%- if note_lines %}\n\t\t\t\t<tr class=\"note\">\n\t\t\t\t\t<td></td>\n\t\t\t\t\t<td>\n\t\t\t\t\t\t<div>Note:</div>\n\t\t\t\t\t\t{%- for line in note_lines %}\n\t\t\t\t\t\t\t<div class=\"note-item\">- {{ line }}</div>\n\t\t\t\t\t\t{%- endfor %}\n\t\t\t\t\t</td>\n\t\t\t\t\t<td colspan=\"3\"></td>\n\t\t\t\t</tr>\n\t\t\t{%- endif %}\n\n\t\t\t<tr class=\"sum\">\n\t\t\t\t<td colspan=\"4\"></td>\n\t\t\t\t<td class=\"money\">{{ frappe.utils.fmt_money(doc.total_quotation_amount) }}</td>\n\t\t\t</tr>\n\t\t</tbody>\n\t</table>\n\n\t<div class=\"tnc\">\n\t\t<div><b>Terms &amp; Conditions :</b></div>\n\t\t<table class=\"terms\">\n\t\t\t<tr>\n\t\t\t\t<td class=\"lbl\">1. Mark up</td>\n\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t<td>{{ doc.get(\"mark_up\") or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"lbl\">2. Delivery Time</td>\n\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t<td>{{ doc.get(\"delivery_time\") or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"lbl\">3. Delivery Point</td>\n\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t<td>{{ doc.get(\"delivery_point\") or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"lbl\">4. Payment</td>\n\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t<td>{{ doc.get(\"payment\") or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"lbl\">5. Validity</td>\n\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t<td>{{ doc.get(\"validity\") or \"\" }}</td>\n\t\t\t</tr>\n\t\t</table>\n\t</div>\n</div>\n",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 15.0,
