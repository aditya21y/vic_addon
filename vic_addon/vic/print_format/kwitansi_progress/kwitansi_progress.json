 "font_size": 14,
 "html": "{#- Kwitansi progress (berbingkai, logo di atas), dicetak dari Sales Invoice. Isiannya dari tab\n    Kwitansi di invoice, sisanya dari invoice / Company / Bank Account - lihat get_kwitansi di\n    vic/print_utils.py. -#}\n\n{%- set vic_hide_letterhead = True -%}\n{%- set kw = get_kwitansi(doc) -%}\n\n<style>\n\t.vic-pf .kp { border: 1.5px solid #000; font-size: 11px; }\n\t.vic-pf .kp-head { text-align: center; padding: 14px 0 10px; border-bottom: 2px solid #000; }\n\t.vic-pf .kp-head img { width: 165px; height: auto; }\n\t.vic-pf .kp-head .co { font-size: 8px; letter-spacing: 0.5px; margin-top: 2px; }\n\t.vic-pf .kp-body { padding: 34px 14px 18px; }\n\t.vic-pf .kp-top { width: 100%; }\n\t.vic-pf .kp-top > tbody > tr > td { vertical-align: bottom; }\n\t.vic-pf .kp-title { font-size: 34px; font-weight: 700; letter-spacing: 1px; font-family: Arial Black, Arial, Helvetica, sans-serif; }\n\t.vic-pf .kp-no { width: 100%; }\n\t.vic-pf .kp-no td { padding: 3px 0 !important; }\n\t.vic-pf .kp-no .lbl { width: 85px; }\n\t.vic-pf .kp-no .sep { width: 12px; }\n\t.vic-pf .kp-no .val { border-bottom: 1px dotted #000 !important; font-weight: 700; font-size: 9.5px; }\n\t.vic-pf .kp-rows { width: 100%; margin-top: 18px; }\n\t.vic-pf .kp-rows td { padding: 3px 4px !important; vertical-align: top; }\n\t.vic-pf .kp-rows .lbl { width: 110px; font-weight: 700; }\n\t.vic-pf .kp-rows .sep { width: 12px; }\n\t.vic-pf .kp-rows .val { border-bottom: 1px solid #bbb !important; }\n\t.vic-pf .kp-rows .gap td { height: 14px; padding: 0 !important; }\n\t.vic-pf .kp-rows .words { font-size: 13px; font-weight: 700; font-style: italic; text-decoration: underline; padding-top: 8px !important; }\n\t.vic-pf .kp-rows .inner { width: 100%; }\n\t.vic-pf .kp-rows .inner td { padding: 0 !important; border: 0 !important; }\n\t.vic-pf .kp-bottom { width: 100%; margin-top: 18px; }\n\t.vic-pf .kp-bottom td { vertical-align: top; }\n\t.vic-pf .kp-amount { font-size: 16px; font-weight: 700; padding-top: 22px !important; }\n\t.vic-pf .kp-sign { text-align: center; font-size: 12px; }\n\t.vic-pf .kp-sign .space { height: 80px; }\n\t.vic-pf .kp-sign .name { font-weight: 700; text-decoration: underline; }\n</style>\n\n<div class=\"vic-pf\">\n\t{%- include \"vic_addon/templates/print_formats/vic_letterhead.html\" -%}\n\n\t<div class=\"kp\">\n\t\t<div class=\"kp-head\">\n\t\t\t<img src=\"/assets/vic_addon/img/vic%20logo.png\" alt=\"{{ doc.company }}\" />\n\t\t\t<div class=\"co\">{{ frappe.db.get_value(\"Company\", doc.company, \"company_name\") | upper }}</div>\n\t\t</div>\n\n\t\t<div class=\"kp-body\">\n\t\t\t<table class=\"kp-top\">\n\t\t\t\t<tr>\n\t\t\t\t\t<td class=\"kp-title\">KWITANSI</td>\n\t\t\t\t\t<td style=\"width: 48%\">\n\t\t\t\t\t\t<table class=\"kp-no\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td class=\"lbl\">No.</td>\n\t\t\t\t\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t\t\t\t\t<td class=\"val\">{{ kw.no }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td class=\"lbl\">Faktur No.</td>\n\t\t\t\t\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t\t\t\t\t<td class=\"val\">{{ kw.faktur_no }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t</table>\n\n\t\t\t<table class=\"kp-rows\">\n\t\t\t\t<tr>\n\t\t\t\t\t<td class=\"lbl\">Sudah Terima dari</td>\n\t\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t\t<td class=\"val\"><b>{{ kw.received_from }}</b></td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td></td><td></td>\n\t\t\t\t\t<td class=\"val\">{{ kw.project or \"&nbsp;\" }}</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr class=\"gap\"><td colspan=\"3\"></td></tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td class=\"lbl\">Sejumlah Uang</td>\n\t\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t\t<td class=\"val words\">{{ terbilang(kw.amount) }}</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr class=\"gap\"><td colspan=\"3\"></td></tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td class=\"lbl\">Untuk Pembayaran</td>\n\t\t\t\t\t<td class=\"sep\">:</td>\n\t\t\t\t\t<td class=\"val\"><b>{{ kw.payment_for }}</b></td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td></td><td></td>\n\t\t\t\t\t<td class=\"val\">Sesuai Dengan :</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td></td><td></td>\n\t\t\t\t\t<td class=\"val\">\n\t\t\t\t\t\t<table class=\"inner\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td style=\"width: 14%\">SPP No :</td>\n\t\t\t\t\t\t\t\t<td style=\"width: 46%\"><b>{{ kw.spp_no }}</b></td>\n\t\t\t\t\t\t\t\t<td style=\"width: 13%\">Tanggal :</td>\n\t\t\t\t\t\t\t\t<td style=\"text-align: center\">{{ tanggal(kw.spp_date) }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr><td></td><td></td><td class=\"val\">&nbsp;</td></tr>\n\t\t\t\t<tr><td></td><td></td><td class=\"val\">&nbsp;</td></tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td></td><td></td>\n\t\t\t\t\t<td class=\"val\">\n\t\t\t\t\t\t<table class=\"inner\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td style=\"width: 30%\">Periode Tanggal :</td>\n\t\t\t\t\t\t\t\t<td style=\"width: 25%; text-align: center\"><b>{{ tanggal(kw.period_from) }}</b></td>\n\t\t\t\t\t\t\t\t<td style=\"width: 15%; text-align: center\">s/d</td>\n\t\t\t\t\t\t\t\t<td style=\"text-align: center\"><b>{{ tanggal(kw.period_to) }}</b></td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr class=\"gap\"><td colspan=\"3\"></td></tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td></td><td></td>\n\t\t\t\t\t<td class=\"val\">\n\t\t\t\t\t\t<table class=\"inner\">\n\t\t\t\t\t\t\t<tr><td style=\"width: 18%\">No. Rekening</td><td style=\"width: 4%\">:</td><td>{{ kw.account_no }}</td></tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td></td><td></td>\n\t\t\t\t\t<td class=\"val\">\n\t\t\t\t\t\t<table class=\"inner\">\n\t\t\t\t\t\t\t<tr><td style=\"width: 18%\">Bank</td><td style=\"width: 4%\">:</td><td>{{ kw.bank }}{% if kw.bank_branch %} - {{ kw.bank_branch }}{% endif %}</td></tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td></td><td></td>\n\t\t\t\t\t<td class=\"val\">\n\t\t\t\t\t\t<table class=\"inner\">\n\t\t\t\t\t\t\t<tr><td style=\"width: 18%\">Atas Nama</td><td style=\"width: 4%\">:</td><td>{{ kw.account_name }}</td></tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t</table>\n\n\t\t\t<table class=\"kp-bottom\">\n\t\t\t\t<tr>\n\t\t\t\t\t<td class=\"kp-amount\" style=\"width: 55%\">Rp.&nbsp;&nbsp;&nbsp;{{ \"{:,.0f}\".format(kw.amount | float) }}</td>\n\t\t\t\t\t<td class=\"kp-sign\">\n\t\t\t\t\t\t<div>{{ kw.city }}, {{ tanggal(kw.date) }}</div>\n\t\t\t\t\t\t<div class=\"space\"></div>\n\t\t\t\t\t\t<div class=\"name\">{{ kw.signer | upper }}</div>\n\t\t\t\t\t\t{%- if kw.signer_title %}<div>{{ kw.signer_title }}</div>{% endif %}\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t</table>\n\t\t</div>\n\t</div>\n</div>\n",
